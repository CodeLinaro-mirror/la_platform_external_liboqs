package {
    default_applicable_licenses: ["external_liboqs_license"],
}

license {
    name: "external_liboqs_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-BSD",
        "SPDX-license-identifier-CC0-1.0",
        "SPDX-license-identifier-MIT",
        "SPDX-license-identifier-NIST",
    ],
    license_text: [
        "LICENSE",
    ],
}
